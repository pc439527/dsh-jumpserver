node_modules/
dist/
*.tsbuildinfo

# lib/ IS COMMITTED ON PURPOSE. The GitHub install path
# (dsh plugin --profile desktop add github:pc439527/dsh-jumpserver) ships
# the prebuilt plugin so it loads without a local toolchain. Regenerate with
# `npm run build` and commit lib/ alongside src/; `npm run check:lib` guards
# against forgetting. Only esbuild's intermediate is ignored — build-client.mjs
# deletes it on success, so a leftover means a build died mid-flight.
lib/_client-impl.cjs

# Local scratch: npm cache routing, package extractions, probe scripts
.tmp-*

# Local diagnostics / acceptance artifacts (may contain real internal network info)
*.log
CONOUT$
npm.log
pnpm-check.log
acceptance-snapshot.md
*.har
jumpserver-audit-*
audit-export-*

# Local credentials / private keys (never commit)
.credentials.yaml
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Git bundles are local backup artifacts, never release sources
submission/*.bundle

# Generated reports
classifier-report.json

# Local WorkBuddy agent memory
.workbuddy/

